<Window
    x:Class="CoffeeFilter.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CoffeeFilter"
    Title="Coffee Filter flyout">

    <!-- Window Root: the margin around the panel is part of the window, so the window's edge
         at the taskbar is where the sliding panel gets cut off -->
    <Grid x:Name="WindowRoot" Padding="12">
        <Grid.Resources>
            <!-- Theme Brushes -->
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="#0F000000" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="#33000000" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <!-- Flyout Card: a setting's icon, name, and control, like a Settings card -->
                <Style x:Key="FlyoutCardStyle" TargetType="Grid">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="MinHeight" Value="64" />
                    <Setter Property="ColumnSpacing" Value="16" />
                </Style>

                <!-- Footer Buttons -->
                <Style x:Key="FooterIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Slide Host: moves in and out; the panel inside keeps its own depth for the shadow -->
        <Grid x:Name="SlideHost">

            <!-- Panel -->
            <Grid x:Name="Panel"
                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Translation="0,0,32">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>

                <!-- Acrylic Background (its backdrop is set in code) -->
                <SystemBackdropElement x:Name="Acrylic" CornerRadius="8" />

                <!-- Content: takes its natural height, so the panel's own Height can animate to it -->
                <StackPanel x:Name="PanelContent" VerticalAlignment="Top">

                    <!-- Controls -->
                    <StackPanel Padding="16" Spacing="4">

                        <!-- Ad Blocking -->
                        <Grid Style="{StaticResource FlyoutCardStyle}" ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Glyph="&#xEA18;" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ad blocking" />
                                <TextBlock x:Name="BlockingText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="BlockingSwitch"
                                          Grid.Column="2"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          AutomationProperties.Name="Turn ad blocking on or off"
                                          Toggled="OnBlockingToggled" />
                        </Grid>

                        <!-- Update Lists -->
                        <Grid Style="{StaticResource FlyoutCardStyle}" ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Glyph="&#xE72C;" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Update lists" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                                <Button x:Name="UpdateButton" Content="Update now" Click="OnUpdateClicked" />
                            </StackPanel>
                        </Grid>

                        <!-- Excluded Sites -->
                        <Grid Style="{StaticResource FlyoutCardStyle}" ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Glyph="&#xE8D7;" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Excluded sites" />
                                <TextBlock x:Name="ExclusionsText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="AddSiteButton" Grid.Column="2" Content="Add site" VerticalAlignment="Center" Click="OnAddSiteClicked" />
                        </Grid>

                        <!-- Add Site (opened by Add site) -->
                        <Grid x:Name="AddSitePanel" Margin="0,4,0,0" ColumnSpacing="8" ColumnDefinitions="*,Auto" Visibility="Collapsed">
                            <TextBox x:Name="SiteBox"
                                     PlaceholderText="mybank.com"
                                     AutomationProperties.Name="Site to exclude"
                                     KeyDown="OnSiteBoxKeyDown" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <ProgressRing x:Name="AddSiteRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                                <Button x:Name="SaveSiteButton" Content="Add" Style="{StaticResource AccentButtonStyle}" Click="OnSaveSiteClicked" />
                            </StackPanel>
                        </Grid>
                        <!-- /Excluded Sites -->

                        <!-- Excluded Apps -->
                        <Grid Style="{StaticResource FlyoutCardStyle}" ColumnDefinitions="Auto,*,Auto">
                            <FontIcon Glyph="&#xED35;" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Excluded apps" />
                                <TextBlock x:Name="AppsText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="AddAppButton" Grid.Column="2" Content="Add app" VerticalAlignment="Center" Click="OnAddAppClicked" />
                        </Grid>

                        <!-- Add App (opened by Add app; each choice opens its picker in the window) -->
                        <Grid x:Name="AddAppPanel" Margin="0,4,0,0" ColumnSpacing="8" ColumnDefinitions="*,*" Visibility="Collapsed">
                            <Button x:Name="AddProgramButton" HorizontalAlignment="Stretch" AutomationProperties.Name="Program…" Click="OnAddProgramClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7AC;" FontSize="16" />
                                    <TextBlock Text="Program…" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddStoreAppButton" Grid.Column="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Store app…" Click="OnAddStoreAppClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE719;" FontSize="16" />
                                    <TextBlock Text="Store app…" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- /Excluded Apps -->

                        <TextBlock x:Name="Message"
                                   Margin="2,4,2,0"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <!-- /Controls -->

                    <!-- Footer -->
                    <Grid Height="52"
                          Padding="12,0"
                          CornerRadius="0,0,7,7"
                          Background="{ThemeResource FlyoutFooterBackgroundBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource FooterIconButtonStyle}"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Settings"
                                ToolTipService.ToolTip="Settings"
                                Click="OnSettingsClicked">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                        </Button>
                    </Grid>
                    <!-- /Footer -->
                </StackPanel>
                <!-- /Content -->
            </Grid>
            <!-- /Panel -->
        </Grid>
        <!-- /Slide Host -->
    </Grid>
</Window>
