<Project Sdk="Microsoft.NET.Sdk">

    <!-- UI Tests (drive the installed Coffee Filter app through Windows UI Automation) -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Packages -->
    <ItemGroup>
        <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

    <!-- Reads the saved shortcut the same way the app does -->
    <ItemGroup>
        <Compile Include="..\..\app\Hotkey.cs" Link="Hotkey.cs" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <!-- One window, so tests run one at a time -->
    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
